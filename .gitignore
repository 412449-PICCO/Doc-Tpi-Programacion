# Material de origen (se distribuye por la catedra)
*.pdf
# Excepción: PDF de muestra que sirve el endpoint /api/llm/rag/documents/sample (recurso de la app)
!llm-service/src/main/resources/fuentes/*.pdf

# Python
__pycache__/
*.pyc

# Build de Java
target/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.iml

# Obsidian (vault local, no se sube)
.obsidian/

# Borradores de trabajo, no se suben
mañana*.html

# Configuracion con secretos. docker compose levanta el .env que este al lado del
# compose file sin que nadie se lo pida, y el README de la demo muestra las lineas a
# pegar ahi --incluida GROQ_API_KEY--. Sin esta regla, el que las pegue commitea la
# key sin darse cuenta.
.env
.env.*
!.env.example
node_modules/
demoLLMSpringAi/FE/node_modules/
  
 
llm-service/target/llm-service-0.0.1-SNAPSHOT.jar
*.jar
